<div class="autoscroll">
  <table class="list issues">
    <thead>
      <tr>
        <th><%= l(:field_project) %></th>
        <th><%= l(:field_issue) %></th>
        <th><%= l(:field_status) %></th>
        <th><%= l(:field_priority) %></th>
        <th><%= l(:field_assigned_to) %></th>
        <th><%= l(:label_pinned_at, default: 'Pinned At') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% pins.each do |pin| %>
        <tr id="pinned-issue-<%= pin.issue.id %>" class="issue hascontextmenu <%= pin.issue.status.is_closed? ? 'closed' : '' %>">
          <td class="project"><%= link_to_project(pin.issue.project) %></td>
          <td class="subject"><%= link_to_issue(pin.issue) %></td>
          <td class="status"><%= pin.issue.status.name %></td>
          <td class="priority"><%= pin.issue.priority.name %></td>
          <td class="assigned_to"><%= avatar(pin.issue.assigned_to, size: "14") %> <%= link_to_user(pin.issue.assigned_to) %></td>
          <td class="created_on"><%= format_time(pin.created_at) %></td>
          <td class="buttons">
             <%= link_to l(:button_unpin, default: 'Unpin'), toggle_pins_path(issue_id: pin.issue.id), method: :post, remote: true, class: 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
