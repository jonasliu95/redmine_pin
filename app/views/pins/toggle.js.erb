$('#redmine-pin-toggle-btn').replaceWith('<%= j render(partial: "pins/toggle_button", locals: { issue: @issue, pinned: @pinned }) %>');
<% unless @pinned %>
  // If we are on the pins index page, remove the unpinned element instantly
  $('#pinned-issue-<%= @issue.id %>').fadeOut(300, function() {
    $(this).remove();
    $('.project-group').each(function() {
      if ($(this).find('[id^="pinned-issue-"]').length === 0) {
        $(this).remove();
      }
    });
    if ($('[id^="pinned-issue-"]').length === 0) {
      $('.pins-grid, .autoscroll').remove();
      $('.pins-toolbar').after('<p class="nodata"><%= j l(:label_no_data) %></p>');
    }
  });
<% end %>
